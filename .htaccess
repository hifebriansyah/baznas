# Local Apache only (GitHub Pages ignores this file, and it is not copied into build/client/).
# Serves the built site from build/client/ at http://localhost/for-fun/baznas/ (build it with `npm run build:local`).
# Needs mod_rewrite and `AllowOverride FileInfo` (or All) for this folder, like ../guru/.htaccess.
# Always check with the server for a fresh copy while developing (a 304 answer is cheap).
<IfModule mod_headers.c>
  Header set Cache-Control "no-cache"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /for-fun/baznas/
  # / -> the built page
  RewriteRule ^$ build/client/index.html [L]
  # a file of the build: assets/, storybook/ files, favicon.svg, robots.txt, sitemap.xml, ...
  RewriteCond %{DOCUMENT_ROOT}/for-fun/baznas/build/client/$1 -f
  RewriteRule ^(.+)$ build/client/$1 [L]
  # /storybook -> /storybook/ (a folder of the build has an index.html)
  RewriteCond %{DOCUMENT_ROOT}/for-fun/baznas/build/client/$1/index.html -f
  RewriteRule ^(.+[^/])$ %{REQUEST_URI}/ [R=301,L]
  # /storybook/ -> build/client/storybook/index.html
  RewriteCond %{DOCUMENT_ROOT}/for-fun/baznas/build/client/$1index.html -f
  RewriteRule ^(.+/)$ build/client/$1index.html [L]
  # the app's own addresses (/permohonan, /permohonan/12/assessment, /mustahik/3, /login, ...) have no file: the page opens and routes
  # them itself, like 404.html does on GitHub Pages. An address that ends in a file name (a missing .js or .css) stays a real 404.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(?!.*\.[A-Za-z0-9]+$).+$ build/client/404.html [L]
</IfModule>
